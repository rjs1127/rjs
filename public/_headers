# v9.46 — browser cache policy for versioned static assets
# HTML/version/manifest must revalidate so a new deploy can advertise new asset URLs.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/version.json
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# These files are referenced with explicit ?v= cache-busting URLs.
# When any file below changes, its ?v= value MUST change in the same deploy.
/app.js
  Cache-Control: public, max-age=31536000, immutable

/style.css
  Cache-Control: public, max-age=31536000, immutable

/theme.css
  Cache-Control: public, max-age=31536000, immutable
