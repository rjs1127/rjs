# v9.47 — browser cache policy for versioned static assets
# HTML/version/manifest must revalidate so a new deploy can advertise new asset URLs.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/version.json
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# These files are referenced with explicit ?v= cache-busting URLs.
# The build helper rewrites the final ?v= to each file's content hash; source values remain a fallback for no-build environments.
/app.js
  Cache-Control: public, max-age=31536000, immutable

/style.css
  Cache-Control: public, max-age=31536000, immutable

/theme.css
  Cache-Control: public, max-age=31536000, immutable

# Always revalidate worker code; never give the worker an immutable URL.
/body-sw.js
  Cache-Control: no-cache
